# Paystack secret key — get it from https://dashboard.paystack.com/#/settings/developers
# Use an sk_test_ key for testing and an sk_live_ key in production.
# Required for the /payment page (transaction initialize + verify) and the webhook signature check.
PAYSTACK_SECRET_KEY=

# Paystack public key — safe to expose to the browser, used by the inline Popup checkout.
# Use a pk_test_ key for testing and a pk_live_ key in production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# After deploying, register this URL as your webhook in the Paystack dashboard
# (Settings > API Keys & Webhooks): https://yourdomain.com/api/paystack/webhook

# Optional: forward contact form submissions to a Formspree endpoint
CONTACT_FORMSPREE_ENDPOINT=
